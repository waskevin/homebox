# Multilingual file for TOS 7 Docker application. All 14 languages are REQUIRED.

[en-us]
name = "HomeBox"
auth = "waskevin"
descript = "HomeBox is a self-hosted home inventory system. Track locations, labels, warranties, prices, photos and attachments for everything you own, with a web UI and a REST API."
release_note = "1.0.1: added licence/attribution notices and a privacy policy and upgraded the container image to 0.27.1."
important = "DockerEngine must be installed and enabled from the TOS App Center. Docker image source: Docker Hub. License: AGPL-3.0. Source code, notices and privacy policy: https://github.com/waskevin/homebox"

